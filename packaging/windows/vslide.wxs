<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <Package Name="VSlide" Manufacturer="Learning Machines LLC" Version="$(var.Version)" UpgradeCode="6F9C69E7-7825-40D2-BF26-C274DA676425" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="VSlide presentations and slide shows" Manufacturer="Learning Machines LLC" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of VSlide is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="VslideIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="VslideIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://getartcraft.com/apps/vslide" />
    <Property Id="ARPURLUPDATEINFO" Value="https://getartcraft.com/apps/vslide" />
    <Property Id="ARPHELPLINK" Value="https://discord.gg/artcraft" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="ArtCraft">
        <Directory Id="INSTALLFOLDER" Name="VSlide" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="VSlide" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="VslideFiles" />
    </Feature>
  <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="NOT Installed" />
    </UI>
  </Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="VslideFiles" Directory="INSTALLFOLDER">
      <Component Id="VslideApp" Guid="D87EA444-41A4-4C19-922E-66D1A29461FF">
        <File Id="VslideNotice" Source="$(var.BinDir)\NOTICE" KeyPath="no" />
        <File Id="VslideExe" Source="$(var.BinDir)\vslide.exe" KeyPath="yes">
          <!-- No Icon here, so the shortcut shows the icon embedded in vslide.exe (build.rs). An
               MSI Icon is cached under %APPDATA%\Microsoft\Installer\{ProductCode}\, and every
               update is a major upgrade with a new ProductCode that deletes the old folder. A
               taskbar pin is a copy of this shortcut that the update never touches, so it kept
               pointing at the deleted file and lost its icon (#1114). The exe's path survives
               updates; the shortcut is not advertised, so it targets that path and its icon is the
               exe's own. The Icon above stays for ARPPRODUCTICON (Apps and features). -->
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="VSlide" Description="VSlide presentations and slide shows" WorkingDirectory="INSTALLFOLDER" Advertise="no" />
        </File>

        <!-- .vslide: VSlide's own format. -->
        <ProgId Id="VSlide.Presentation" Description="VSlide Presentation" Icon="VslideExe" IconIndex="0">
          <Extension Id="vslide" ContentType="application/x-vslide">
            <Verb Id="open" Command="Open" TargetFile="VslideExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>

        <!-- "Open with" for PowerPoint formats, without becoming the default. -->
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\vslide.exe" Name="FriendlyAppName" Value="VSlide" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\vslide.exe\shell\open\command" Value="&quot;[#VslideExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\vslide.exe\SupportedTypes" Name=".vslide" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\vslide.exe\SupportedTypes" Name=".pptx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\vslide.exe\SupportedTypes" Name=".potx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\vslide.exe\SupportedTypes" Name=".ppsx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\vslide.exe\SupportedTypes" Name=".ppt" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\vslide.exe\SupportedTypes" Name=".pot" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\vslide.exe\SupportedTypes" Name=".pps" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.pptx\OpenWithProgids" Name="VSlide.Presentation" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.potx\OpenWithProgids" Name="VSlide.Presentation" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.ppsx\OpenWithProgids" Name="VSlide.Presentation" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.ppt\OpenWithProgids" Name="VSlide.Presentation" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.pot\OpenWithProgids" Name="VSlide.Presentation" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.pps\OpenWithProgids" Name="VSlide.Presentation" Value="" Type="string" />

        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\vslide.exe" Value="[#VslideExe]" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\VSlide" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="VslideCli">
        <File Id="VslideCliExe" Source="$(var.BinDir)\vslide-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
